{
  "name": "@jcancelo/google-wallet",
  "version": "1.1.0",
  "description": "Librería moderna, tipada y 100% en español para crear, firmar y emitir pases de Google Wallet (Eventos, Credenciales y Membresías) en Node.js, Next.js y React.",
  "author": "Julian Cancelo <jcancelo.dev@gmail.com>",
  "license": "MIT",
  "keywords": [
    "google-wallet",
    "google-pay",
    "pases-digitales",
    "wallet",
    "billetera-digital",
    "credenciales",
    "event-ticket",
    "entradas",
    "pass",
    "react",
    "nextjs",
    "espanol"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julianmcancelo/google-wallet.git"
  },
  "bugs": {
    "url": "https://github.com/julianmcancelo/google-wallet/issues"
  },
  "homepage": "https://github.com/julianmcancelo/google-wallet#readme",
  "bin": {
    "google-wallet": "bin/cli.js"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "GUIA_GOOGLE_WALLET.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "demo": "vite",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/google-wallet.test.ts",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.2"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite": "^8.2.2"
  }
}
